  "templating": {
    "list": [
      {
        "name": "process",
        "label": "Processus",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(codex_host_process_threads, process)",
        "query": {
          "query": "label_values(codex_host_process_threads, process)",
          "refId": "ProcessVariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Inventaire courant",
      "description": "Le PID parent aide à suivre la filiation, y compris pour les auxiliaires génériques.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "codex_host_process_threads{process=~\"${process:regex}\"}",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Threads",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "process": "Processus",
              "pid": "PID",
              "parent_pid": "PID parent",
              "Value": "Threads"
            }
          }
        }
      ]
    },
    {
      "id": 2,
