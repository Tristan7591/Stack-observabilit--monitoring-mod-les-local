{
  "title": "Codex · Requêtes et transport",
  "uid": "codex-requests",
  "tags": [
    "codex",
    "local"
  ],
  "description": "Tentatives et latences de transport instrumentées, flux, retentatives HTTP et traces de requêtes.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Modèle",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=\"codex-otlp\",__name__=~\"codex_(api_request_total|websocket_(request|connect|continuation)_total|turn_e2e_duration_ms(_milliseconds)?_count)\"}, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "latency_window",
        "label": "Fenêtre des percentiles",
        "type": "custom",
        "query": "5m,15m,30m,1h",
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "15m",
          "value": "15m"
        },
        "options": [
          {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": true,
            "text": "15m",
            "value": "15m"
          },
          {
            "selected": false,
            "text": "30m",
            "value": "30m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          }
        ]
      }
    ]
  },
