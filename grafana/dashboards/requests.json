  "panels": [
    {
      "id": 1,
      "title": "Tentatives HTTP",
      "description": "Variation estimée du compteur client sur la période. Inclut les tentatives ultérieures qui ont été émises.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_total\"}[$__range]))",
          "editorMode": "code",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
