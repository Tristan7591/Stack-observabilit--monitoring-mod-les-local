          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_websocket_connect_duration_ms(_milliseconds)?_bucket\"}[$latency_window]))) and (sum (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_websocket_connect_duration_ms(_milliseconds)?_count\"}[$latency_window])) >= 1)",
          "editorMode": "code",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_websocket_connect_duration_ms(_milliseconds)?_bucket\"}[$latency_window]))) and (sum (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_websocket_connect_duration_ms(_milliseconds)?_count\"}[$latency_window])) >= 20)",
          "editorMode": "code",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
