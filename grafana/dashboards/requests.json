    {
      "id": 13,
      "title": "Latence d’ouverture WebSocket",
      "description": "Durée d’une tentative d’établissement de connexion WebSocket. Les percentiles sont estimés pour la fenêtre glissante. p50 à partir d’une observation, p95 à partir de vingt.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
