          },
          "expr": "(sum (rate({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_total\",success=\"false\"}[$__rate_interval])) or (0 * sum (rate({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_total\",success=~\"true|false\"}[$__rate_interval])))) / (sum (rate({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_total\",success=~\"true|false\"}[$__rate_interval])) > 0)",
