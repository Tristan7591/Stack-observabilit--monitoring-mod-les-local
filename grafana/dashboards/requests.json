    {
      "id": 11,
      "title": "Latence HTTP",
      "description": "Durée d’une tentative HTTP. Pour une réponse en flux, la mesure couvre l’ouverture du flux. Les percentiles sont estimés pour la fenêtre glissante. p50 à partir d’une observation, p95 à partir de vingt.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_duration_ms(_milliseconds)?_bucket\"}[$latency_window]))) and (sum (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_duration_ms(_milliseconds)?_count\"}[$latency_window])) >= 1)",
          "editorMode": "code",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_duration_ms(_milliseconds)?_bucket\"}[$latency_window]))) and (sum (increase({job=\"codex-otlp\",model=~\"$model\",__name__=~\"codex_api_request_duration_ms(_milliseconds)?_count\"}[$latency_window])) >= 20)",
          "editorMode": "code",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
